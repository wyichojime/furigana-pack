<Project Sdk="Microsoft.NET.Sdk">
  <!-- 使う側（WPF など）が csharp/FuriganaPack/*.cs をコピーしてもビルドできることの確認。プロジェクト参照はしない -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Library</OutputType>
    <RootNamespace>FuriganaPack.WpfCheck</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\FuriganaPack\*.cs" />
  </ItemGroup>
</Project>
